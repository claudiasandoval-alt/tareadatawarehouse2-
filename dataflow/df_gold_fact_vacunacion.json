{
	"name": "df_gold_fact_vacunacion",
	"properties": {
		"folder": {
			"name": "gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "silver_vacunacion_consolidada",
						"type": "DatasetReference"
					},
					"name": "origenHechos"
				},
				{
					"dataset": {
						"referenceName": "silver_catalogo_departamentos",
						"type": "DatasetReference"
					},
					"name": "origenDeptos"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          registro_id as string,",
				"          ci_paciente as string,",
				"          nombres as string,",
				"          primer_apellido as string,",
				"          segundo_apellido as string,",
				"          cod_paciente as string,",
				"          genero as string,",
				"          fecha_nacimiento as date,",
				"          pueblo_indigena as string,",
				"          cod_vacuna as string,",
				"          desc_vacuna as string,",
				"          nro_dosis as integer,",
				"          fecha_vacunacion as date,",
				"          cod_establecimiento as string,",
				"          desc_establecimiento as string,",
				"          municipio as string,",
				"          departamento as string,",
				"          lote_vacuna as string,",
				"          temperatura_conservacion as decimal(5,2),",
				"          edad_dias_aplicacion as integer,",
				"          via_aplicacion as string,",
				"          aplicacion_oportuna as string,",
				"          fuente_origen as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> origenHechos",
				"source(output(",
				"          municipio_id as string,",
				"          municipio_nombre as string,",
				"          departamento as string,",
				"          codigo_departamento as string,",
				"          zona_geografica as string,",
				"          es_capital_departamental as string,",
				"          poblacion_depto_estimada as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> origenDeptos",
				"origenHechos, origenDeptos join(municipio == municipio_nombre,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          registro_id,",
				"          ci_paciente,",
				"          nombres,",
				"          primer_apellido,",
				"          segundo_apellido,",
				"          cod_paciente,",
				"          genero,",
				"          fecha_nacimiento,",
				"          pueblo_indigena,",
				"          cod_vacuna,",
				"          desc_vacuna,",
				"          nro_dosis,",
				"          fecha_vacunacion,",
				"          cod_establecimiento,",
				"          desc_establecimiento,",
				"          municipio,",
				"          departamento = origenHechos@departamento,",
				"          lote_vacuna,",
				"          temperatura_conservacion,",
				"          edad_dias_aplicacion,",
				"          via_aplicacion,",
				"          aplicacion_oportuna,",
				"          fuente_origen,",
				"          municipio_id,",
				"          municipio_nombre,",
				"          departamento = origenDeptos@departamento,",
				"          codigo_departamento,",
				"          zona_geografica,",
				"          es_capital_departamental,",
				"          poblacion_depto_estimada",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1"
			]
		}
	}
}