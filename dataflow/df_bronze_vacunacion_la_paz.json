{
	"name": "df_bronze_vacunacion_la_paz",
	"properties": {
		"folder": {
			"name": "bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "vacunacion_la_paz_csv",
						"type": "DatasetReference"
					},
					"name": "origenLaPaz"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "bronze_vacunacion_la_paz",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id_registro as string,",
				"          cod_paciente as string,",
				"          documento_identidad as string,",
				"          nombres as string,",
				"          primer_apellido as string,",
				"          segundo_apellido as string,",
				"          genero as string,",
				"          fec_nacimiento as string,",
				"          municipio as string,",
				"          pueblo_indigena as string,",
				"          fec_vacunacion as string,",
				"          cod_vacuna as string,",
				"          desc_vacuna as string,",
				"          nro_dosis as string,",
				"          cod_establecimiento as string,",
				"          desc_establecimiento as string,",
				"          depto as string,",
				"          nro_lote as string,",
				"          temp_conservacion as string,",
				"          edad_dias as string,",
				"          via_aplicacion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> origenLaPaz",
				"origenLaPaz derive(id_registro = trim(id_registro),",
				"          cod_paciente = trim(cod_paciente),",
				"          documento_identidad = trim(documento_identidad),",
				"          nombres = trim(nombres),",
				"          primer_apellido = trim(primer_apellido),",
				"          segundo_apellido = trim(segundo_apellido),",
				"          genero = trim(genero),",
				"          fec_nacimiento = trim(fec_nacimiento),",
				"          municipio = trim(municipio),",
				"          pueblo_indigena = trim(pueblo_indigena),",
				"          fec_vacunacion = trim(fec_vacunacion),",
				"          cod_vacuna = trim(cod_vacuna),",
				"          desc_vacuna = trim(desc_vacuna),",
				"          nro_dosis = trim(nro_dosis),",
				"          cod_establecimiento = trim(cod_establecimiento),",
				"          desc_establecimiento = trim(desc_establecimiento),",
				"          depto = trim(depto),",
				"          nro_lote = trim(nro_lote),",
				"          temp_conservacion = trim(temp_conservacion),",
				"          edad_dias = trim(edad_dias),",
				"          via_aplicacion = trim(via_aplicacion)) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          correlativo_sin_nombre as string,",
				"          nombres as string,",
				"          primer_apellido as string,",
				"          segundo_apellido as string,",
				"          documento_identidad as string,",
				"          cod_paciente as string,",
				"          genero as string,",
				"          fec_nacimiento as string,",
				"          pueblo_indigena as string,",
				"          cod_vacuna as string,",
				"          desc_vacuna as string,",
				"          nro_dosis as string,",
				"          fec_vacunacion as string,",
				"          cod_establecimiento as string,",
				"          desc_establecimiento as string,",
				"          municipio as string,",
				"          depto as string,",
				"          nro_lote as string,",
				"          temp_conservacion as string,",
				"          edad_dias as string,",
				"          via_aplicacion as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          nombres,",
				"          primer_apellido,",
				"          segundo_apellido,",
				"          documento_identidad,",
				"          cod_paciente,",
				"          genero,",
				"          fec_nacimiento,",
				"          pueblo_indigena,",
				"          cod_vacuna,",
				"          desc_vacuna,",
				"          nro_dosis,",
				"          fec_vacunacion,",
				"          cod_establecimiento,",
				"          desc_establecimiento,",
				"          municipio,",
				"          depto,",
				"          nro_lote,",
				"          temp_conservacion,",
				"          edad_dias,",
				"          via_aplicacion",
				"     )) ~> sink1"
			]
		}
	}
}