{
	"name": "df_gold_fact_vacunacion",
	"properties": {
		"folder": {
			"name": "gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "silver_vacunacion_consolidada",
						"type": "DatasetReference"
					},
					"name": "origenHechos"
				},
				{
					"dataset": {
						"referenceName": "silver_catalogo_departamentos",
						"type": "DatasetReference"
					},
					"name": "origenDeptos"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "gold_fact_vacunacion",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          registro_id as string,",
				"          ci_paciente as string,",
				"          nombres as string,",
				"          primer_apellido as string,",
				"          segundo_apellido as string,",
				"          cod_paciente as string,",
				"          genero as string,",
				"          fecha_nacimiento as date,",
				"          pueblo_indigena as string,",
				"          cod_vacuna as string,",
				"          desc_vacuna as string,",
				"          nro_dosis as integer,",
				"          fecha_vacunacion as date,",
				"          cod_establecimiento as string,",
				"          desc_establecimiento as string,",
				"          municipio as string,",
				"          departamento as string,",
				"          lote_vacuna as string,",
				"          temperatura_conservacion as decimal(5,2),",
				"          edad_dias_aplicacion as integer,",
				"          via_aplicacion as string,",
				"          aplicacion_oportuna as string,",
				"          fuente_origen as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> origenHechos",
				"source(output(",
				"          municipio_id as string,",
				"          municipio_nombre as string,",
				"          departamento as string,",
				"          codigo_departamento as string,",
				"          zona_geografica as string,",
				"          es_capital_departamental as string,",
				"          poblacion_depto_estimada as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> origenDeptos",
				"origenHechos, origenDeptos join(municipio == municipio_nombre,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 select(mapColumn(",
				"          registro_id,",
				"          ci_paciente,",
				"          cod_paciente,",
				"          genero,",
				"          fecha_nacimiento,",
				"          pueblo_indigena,",
				"          vacuna_id = cod_vacuna,",
				"          nro_dosis,",
				"          fecha_vacunacion,",
				"          establecimiento_id = cod_establecimiento,",
				"          lote_vacuna,",
				"          temperatura_conservacion,",
				"          edad_dias_aplicacion,",
				"          via_aplicacion,",
				"          aplicacion_oportuna,",
				"          fuente_origen,",
				"          municipio_id,",
				"          departamento = origenDeptos@departamento",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          registro_id as string,",
				"          ci_paciente as string,",
				"          cod_paciente as string,",
				"          genero as string,",
				"          pueblo_indigena as string,",
				"          fecha_nacimiento as date,",
				"          fecha_vacunacion as date,",
				"          municipio_id as string,",
				"          establecimiento_id as string,",
				"          vacuna_id as string,",
				"          nro_dosis as integer,",
				"          lote_vacuna as string,",
				"          temperatura_conservacion as decimal(5,2),",
				"          edad_dias_aplicacion as integer,",
				"          via_aplicacion as string,",
				"          aplicacion_oportuna as string,",
				"          fuente_origen as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ci_paciente,",
				"          cod_paciente,",
				"          genero,",
				"          pueblo_indigena,",
				"          fecha_nacimiento,",
				"          fecha_vacunacion,",
				"          municipio_id,",
				"          establecimiento_id,",
				"          vacuna_id,",
				"          nro_dosis,",
				"          lote_vacuna,",
				"          temperatura_conservacion,",
				"          edad_dias_aplicacion,",
				"          via_aplicacion,",
				"          aplicacion_oportuna,",
				"          fuente_origen,",
				"          registro_id",
				"     )) ~> sink1"
			]
		}
	}
}